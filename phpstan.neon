includes:
  - phpstan-baseline.neon

parameters:
    level: max
    reportUnmatchedIgnoredErrors: false

    ignoreErrors:
        # The trait is part of the plugin's public API, implemented by integrators' own Channel classes;
        # the only implementation in this repository lives in the excluded test application.
        -
            identifier: trait.unused
            path: src/Model/ChannelTrait.php

        # PHPUnit's assertions are static, but the convention is to call them on $this.
        -
            identifier: staticMethod.dynamicCall
            paths:
                - tests/Functional/*
                - tests/Unit/*
    paths:
        - src
        - tests/Behat
        - tests/Functional
        - tests/Unit
